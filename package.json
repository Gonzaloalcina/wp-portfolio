{
  "name": "wp-portfolio",
  "private": true,
  "description": "Source code for gonzaloalcina.dev.",
  "license": "GPL-2.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:tokens": "node scripts/build-tokens.mjs && node scripts/build-css.mjs",
    "check:tokens": "node scripts/build-tokens.mjs --check",
    "test:tokens": "node --test tests/tokens/",
    "build:css": "node scripts/build-css.mjs",
    "check:css": "node scripts/build-css.mjs --check",
    "test:css": "node --test tests/css/",
    "build:blocks": "wp-scripts build --webpack-src-dir=plugin/blocks/src --output-path=plugin/blocks/build && wp-scripts build-blocks-manifest --input=plugin/blocks/build --output=plugin/blocks/build/blocks-manifest.php",
    "start:blocks": "wp-scripts start --webpack-src-dir=plugin/blocks/src --output-path=plugin/blocks/build",
    "check:blocks": "node scripts/check-blocks.mjs",
    "playground": "node scripts/playground.mjs"
  },
  "devDependencies": {
    "@wordpress/scripts": "35.0.0"
  }
}
