{
  "$description": "wp-portfolio design tokens (W3C Design Tokens format). Every size derives from `unit`; the multiplier lives in $extensions so the build can emit calc(var(--unit) * n).",
  "unit": {
    "$type": "dimension",
    "$value": "8px",
    "$description": "Base unit. Every dimension is a multiple of it, in steps of 0.5."
  },
  "space": {
    "$type": "dimension",
    "0-5": { "$value": "4px",  "$extensions": { "com.gonzaloalcina.unit": 0.5 } },
    "1":   { "$value": "8px",  "$extensions": { "com.gonzaloalcina.unit": 1 } },
    "1-5": { "$value": "12px", "$extensions": { "com.gonzaloalcina.unit": 1.5 } },
    "2":   { "$value": "16px", "$extensions": { "com.gonzaloalcina.unit": 2 } },
    "3":   { "$value": "24px", "$extensions": { "com.gonzaloalcina.unit": 3 } },
    "4":   { "$value": "32px", "$extensions": { "com.gonzaloalcina.unit": 4 } },
    "6":   { "$value": "48px", "$extensions": { "com.gonzaloalcina.unit": 6 } },
    "8":   { "$value": "64px", "$extensions": { "com.gonzaloalcina.unit": 8 } },
    "12":  { "$value": "96px", "$extensions": { "com.gonzaloalcina.unit": 12 } }
  },
  "font": {
    "family": {
      "heading": { "$type": "fontFamily", "$value": ["Newsreader", "Iowan Old Style", "Georgia", "serif"] },
      "body":    { "$type": "fontFamily", "$value": ["Inter", "system-ui", "sans-serif"] }
    },
    "size": {
      "$type": "dimension",
      "sm":   { "$value": "12px", "$extensions": { "com.gonzaloalcina.unit": 1.5 } },
      "base": { "$value": "16px", "$extensions": { "com.gonzaloalcina.unit": 2 } },
      "lg":   { "$value": "24px", "$extensions": { "com.gonzaloalcina.unit": 3 } },
      "xl":   { "$value": "40px", "$extensions": { "com.gonzaloalcina.unit": 5 } }
    },
    "line-height": {
      "$type": "dimension",
      "sm":   { "$value": "16px", "$extensions": { "com.gonzaloalcina.unit": 2 } },
      "base": { "$value": "24px", "$extensions": { "com.gonzaloalcina.unit": 3 } },
      "lg":   { "$value": "32px", "$extensions": { "com.gonzaloalcina.unit": 4 } },
      "xl":   { "$value": "48px", "$extensions": { "com.gonzaloalcina.unit": 6 } }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "heading": { "$value": 500 }
    },
    "tracking": {
      "heading": {
        "$type": "number",
        "$value": -0.02,
        "$description": "Relative to font size, so it is not a unit multiple.",
        "$extensions": { "com.gonzaloalcina.css-unit": "em" }
      }
    }
  },
  "layout": {
    "$type": "dimension",
    "text":   { "$value": "640px",  "$extensions": { "com.gonzaloalcina.unit": 80 } },
    "wide":   { "$value": "1024px", "$extensions": { "com.gonzaloalcina.unit": 128 } },
    "gutter": { "$value": "24px",   "$extensions": { "com.gonzaloalcina.unit": 3 } }
  },
  "line": {
    "width": {
      "$type": "dimension",
      "$value": "1px",
      "$description": "Hairline. Exception to the unit rule.",
      "$extensions": { "com.gonzaloalcina.unit-exception": "hairline" }
    },
    "opacity": {
      "$type": "number",
      "$value": 0.3,
      "$description": "Lines reuse color.muted at this opacity (one grey only)."
    }
  },
  "marker": {
    "size": { "$type": "dimension", "$value": "4px", "$extensions": { "com.gonzaloalcina.unit": 0.5 } }
  },
  "color": {
    "$type": "color",
    "light": {
      "paper": { "$value": "#FAF8F3" },
      "ink":   { "$value": "#1A1A1A" },
      "muted": { "$value": "#6B6B66" }
    },
    "dark": {
      "paper": { "$value": "#171615" },
      "ink":   { "$value": "#ECE9E2" },
      "muted": { "$value": "#9A9791" }
    }
  }
}
