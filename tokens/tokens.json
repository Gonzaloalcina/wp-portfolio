{
  "$description": "wp-portfolio design tokens (W3C Design Tokens format). Every size derives from `unit` (0.5rem); the multiplier lives in $extensions so the build can emit calc(var(--unit) * n).",
  "unit": {
    "$type": "dimension",
    "$value": "0.5rem",
    "$description": "Base unit: 0.5rem, 8px at the default 16px root size. rem keeps the visitor's font size setting. Every dimension is a multiple of it, in steps of 0.5 (font sizes: 0.25)."
  },
  "space": {
    "$type": "dimension",
    "0-5": { "$value": "0.25rem", "$extensions": { "com.gonzaloalcina.unit": 0.5 } },
    "1":   { "$value": "0.5rem",  "$extensions": { "com.gonzaloalcina.unit": 1 } },
    "1-5": { "$value": "0.75rem", "$extensions": { "com.gonzaloalcina.unit": 1.5 } },
    "2":   { "$value": "1rem",    "$extensions": { "com.gonzaloalcina.unit": 2 } },
    "3":   { "$value": "1.5rem",  "$extensions": { "com.gonzaloalcina.unit": 3 } },
    "4":   { "$value": "2rem",    "$extensions": { "com.gonzaloalcina.unit": 4 } },
    "6":   { "$value": "3rem",    "$extensions": { "com.gonzaloalcina.unit": 6 } },
    "8":   { "$value": "4rem",    "$extensions": { "com.gonzaloalcina.unit": 8 } },
    "12":  { "$value": "6rem",    "$extensions": { "com.gonzaloalcina.unit": 12 } }
  },
  "font": {
    "family": {
      "heading": { "$type": "fontFamily", "$value": ["Newsreader", "Iowan Old Style", "Georgia", "serif"] },
      "body":    { "$type": "fontFamily", "$value": ["Inter", "system-ui", "sans-serif"] }
    },
    "size": {
      "$type": "dimension",
      "sm":   { "$value": "0.875rem", "$extensions": { "com.gonzaloalcina.unit": 1.75 } },
      "base": { "$value": "1rem",     "$extensions": { "com.gonzaloalcina.unit": 2 } },
      "lg":   { "$value": "1.5rem",   "$extensions": { "com.gonzaloalcina.unit": 3 } },
      "xl":   { "$value": "2.5rem",   "$extensions": { "com.gonzaloalcina.unit": 5 } }
    },
    "line-height": {
      "$type": "dimension",
      "sm":   { "$value": "1.5rem", "$extensions": { "com.gonzaloalcina.unit": 3 } },
      "base": { "$value": "1.5rem", "$extensions": { "com.gonzaloalcina.unit": 3 } },
      "lg":   { "$value": "2rem",   "$extensions": { "com.gonzaloalcina.unit": 4 } },
      "xl":   { "$value": "3rem",   "$extensions": { "com.gonzaloalcina.unit": 6 } }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "heading": { "$value": 500 },
      "strong":  { "$value": 600 }
    },
    "tracking": {
      "heading": {
        "$type": "number",
        "$value": -0.02,
        "$description": "Relative to font size, so it is not a unit multiple.",
        "$extensions": { "com.gonzaloalcina.css-unit": "em" }
      }
    }
  },
  "layout": {
    "$type": "dimension",
    "text":   { "$value": "40rem",  "$extensions": { "com.gonzaloalcina.unit": 80 } },
    "wide":   { "$value": "64rem",  "$extensions": { "com.gonzaloalcina.unit": 128 } },
    "gutter": { "$value": "1.5rem", "$extensions": { "com.gonzaloalcina.unit": 3 } }
  },
  "line": {
    "width": {
      "$type": "dimension",
      "$value": "1px",
      "$description": "Hairline. Exception to the unit rule.",
      "$extensions": { "com.gonzaloalcina.unit-exception": "hairline" }
    },
    "opacity": {
      "$type": "number",
      "$value": 0.3,
      "$description": "Lines reuse color.muted at this opacity (one grey only)."
    }
  },
  "marker": {
    "size": { "$type": "dimension", "$value": "0.25rem", "$extensions": { "com.gonzaloalcina.unit": 0.5 } }
  },
  "color": {
    "$type": "color",
    "light": {
      "paper": { "$value": "#FAF8F3" },
      "ink":   { "$value": "#1A1A1A" },
      "muted": { "$value": "#6B6B66" }
    },
    "dark": {
      "paper": { "$value": "#171615" },
      "ink":   { "$value": "#ECE9E2" },
      "muted": { "$value": "#9A9791" }
    }
  }
}
