{
  "name": "gonzaloalcina/wp-portfolio",
  "description": "Source code for gonzaloalcina.dev.",
  "type": "project",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.0"
  },
  "config": {
    "platform": {
      "php": "8.0.28"
    },
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "sort-packages": true
  },
  "scripts": {
    "lint": "phpcs",
    "lint:fix": "phpcbf",
    "test": "phpunit"
  },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.2",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "phpunit/phpunit": "^9.6",
    "roots/wordpress-no-content": "7.1.*",
    "wp-coding-standards/wpcs": "^3.4",
    "wp-phpunit/wp-phpunit": "7.1.*",
    "yoast/phpunit-polyfills": "^4.0"
  }
}
