<?xml version="1.0"?>
<ruleset name="wp-portfolio">
	<description>Coding standards for wp-portfolio: WordPress Coding Standards and PHP 8.0+ compatibility.</description>

	<file>theme</file>
	<file>plugin</file>
	<file>tests/php</file>

	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<!-- Generated by @wordpress/scripts; the sources in plugin/blocks/src are linted. -->
	<exclude-pattern>plugin/blocks/build/*</exclude-pattern>
	<!-- Generated by wp i18n make-php from the .po files. -->
	<exclude-pattern>*/languages/*.l10n.php</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>
	<arg name="cache" value=".phpcs-cache"/>

	<!-- WordPress Coding Standards (Core, Docs and Extra). -->
	<rule ref="WordPress"/>

	<config name="minimum_wp_version" value="7.1"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="portfolio-theme"/>
				<element value="portfolio-core"/>
			</property>
		</properties>
	</rule>

	<!-- Globals must be prefixed. Template variables use "portfolio_". -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="portfolio_theme"/>
				<element value="portfolio_core"/>
				<element value="portfolio"/>
			</property>
		</properties>
	</rule>

	<!-- PHPUnit discovers test classes by file name (ContactFormTest.php), and
	     test methods describe themselves through their names. -->
	<rule ref="WordPress.Files.FileName">
		<exclude-pattern>tests/php/*</exclude-pattern>
	</rule>
	<rule ref="Squiz.Commenting.FunctionComment.Missing">
		<exclude-pattern>tests/php/*Test.php</exclude-pattern>
	</rule>

	<!-- The test config defines the constants WordPress itself reads (DB_NAME,
	     ABSPATH…) and passes settings to the test library through putenv(). -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals.NonPrefixedConstantFound">
		<exclude-pattern>tests/php/wp-tests-config.php</exclude-pattern>
		<exclude-pattern>tests/php/bootstrap.php</exclude-pattern>
	</rule>
	<rule ref="WordPress.PHP.DiscouragedPHPFunctions.runtime_configuration_putenv">
		<exclude-pattern>tests/php/bootstrap.php</exclude-pattern>
	</rule>

	<!-- PHP version: the theme and the plugin declare Requires PHP: 8.0. -->
	<config name="testVersion" value="8.0-"/>
	<rule ref="PHPCompatibilityWP"/>
</ruleset>
